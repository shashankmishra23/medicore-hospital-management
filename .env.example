# Copy this file to .env and fill in your own values.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hospital_db

# Any long random text. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# 1 = show detailed errors while developing. Use 0 when others can reach the app.
FLASK_DEBUG=0

# Your hospital's details (shown on the login page, sidebar, receipts and prescriptions)
HOSPITAL_NAME=MediCore Hospital
HOSPITAL_TAGLINE=Modern care, one click away
HOSPITAL_PHONE=+91 512 300 100
HOSPITAL_EMAIL=care@medicore.example
HOSPITAL_ADDRESS=Civil Lines, Kanpur, Uttar Pradesh

# Demo mode: when 1, any password is accepted so you can show the app quickly.
# Keep this 0 for a real hospital.
DEMO_MODE=0
